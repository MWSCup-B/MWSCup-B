{
  "schemaVersion": "1.0",
  "id": "clickfix",
  "label": "ClickFix",
  "category": "social_engineering",
  "description": "偽の修復・本人確認画面に従い利用者が端末側で操作を実行してしまう教材。ページ閲覧だけでは実行されない。効果は当該端末の一般利用者権限での実行に限定し、情報窃取・権限昇格は含めない。",
  "supportedInvestigationTypes": [
    "WEB_LOG",
    "DEVICE",
    "CONFIGURATION"
  ],
  "bindings": [
    {
      "id": "attacker",
      "kind": "entity"
    },
    {
      "id": "victim",
      "kind": "entity"
    },
    {
      "id": "request",
      "kind": "entity"
    },
    {
      "id": "client",
      "kind": "node"
    },
    {
      "id": "browser",
      "kind": "service"
    },
    {
      "id": "web_host",
      "kind": "node"
    },
    {
      "id": "web",
      "kind": "service"
    },
    {
      "id": "endpoint",
      "kind": "service"
    }
  ],
  "targetTypes": [
