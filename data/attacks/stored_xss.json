{
  "schemaVersion": "1.0",
  "id": "stored_xss",
  "label": "Stored XSS",
  "category": "web_injection",
  "description": "保存した投稿が後の閲覧応答で実行可能なスクリプトとして解釈される範囲。投稿権限、永続化、出力時の防御不足、閲覧、実行制御を分離する。資格情報窃取やOS侵害を効果にしない。",
  "supportedInvestigationTypes": [
    "APPLICATION_LOG",
    "WEB_LOG",
    "DEVICE",
    "CONFIGURATION"
  ],
