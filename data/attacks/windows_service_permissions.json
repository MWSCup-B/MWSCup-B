      },
      "conditions": [
        {
          "source": "loggingConfiguration",
          "predicate": "service_acl_record_available",
          "args": [
            "$host"
          ],
          "value": true,
          "description": "この教材では、対象の操作・時刻・実効主体を識別できる計測を事前に有効化し、当該記録を取得・保持している。標準設定での記録を仮定しない。"
        }
      ]
    },
    {
      "id": "service_execution_record",
      "description": "ファイル変更とサービス再起動、および実効主体の計測を時系列で照合する。",
      "acquisition": {
        "binding": "host",
        "logSource": "DEVICE",
