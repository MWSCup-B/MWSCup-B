{
  "schemaVersion": "1.0",
  "id": "windows_service_permissions",
  "label": "Windowsサービス実行ファイルの権限不備",
  "category": "privilege_escalation",
  "stages": [
    "PRIVILEGE_ESCALATION"
  ],
  "description": "書換え可能なサービス実行ファイルを、高権限サービスとして次に起動した場合の権限昇格。再起動権限や起動イベントも必要。",
  "supportedInvestigationTypes": [
    "CONFIGURATION",
    "DEVICE"
  ],
  "authoring": {
    "preferredInvestigationType": "CONFIGURATION",
    "evidenceAnswer": "対象サービスの実行パス・実行アカウント・ファイルACLを確認する。 / ファイル変更とサービス再起動、および実効主体の計測を時系列で照合する。",
    "sourceNodeBinding": "host",
    "targetServiceBinding": "service",
    "investigationServiceBinding": "service"
  },
  "bindings": [
    {
      "id": "attacker",
      "kind": "entity"
    },
    {
      "id": "host",
      "kind": "node"
    },
    {
      "id": "service",
      "kind": "service"
    }
  ],
  "targetTypes": [
    {
      "binding": "attacker",
      "values": [
        "actor"
      ]
    }
  ],
  "requiredRoles": [],
  "platforms": [
    {
      "binding": "host",
      "values": [
        "windows"
      ]
    },
    {
      "binding": "service",
      "values": [
        "windows"
      ]
    }
  ],
  "requiredServices": [
    {
      "binding": "service",
      "node": "host",
      "values": [
        "local_execution"
      ]
    }
  ],
  "prerequisites": [
    {
      "source": "vulnerabilities",
      "predicate": "service_binary_writable",
      "args": [
        "$attacker",
        "$host"
      ],
      "value": true,
      "description": "一般ユーザーが対象サービスの実行ファイルまたは置換可能な親ディレクトリへ書き込める。"
    },
    {
      "source": "otherConditions",
      "predicate": "service_runs_as_local_system",
      "args": [
        "$host"
      ],
      "value": true,
      "description": "対象サービスはLocalSystemとして設定されている。任意のサービスを自動的にSYSTEMとみなさない。"
    },
    {
      "source": "requiredUserActions",
      "predicate": "service_restart_occurs",
      "args": [
        "$host"
      ],
      "value": true,
      "description": "書換え後に、許可されたサービス再起動または記録された管理者の再起動が発生する。低権限ユーザーに再起動権限を仮定しない。"
    },
    {
      "source": "otherConditions",
      "predicate": "replacement_execution_permitted",
      "args": [
        "$host"
      ],
      "value": true,
      "description": "実効アプリケーション制御等が置換された実行ファイルの起動を阻止しない。"
    }
  ],
  "requiredPrivileges": [
    {
      "source": "attackerInitialPrivileges",
      "predicate": "local_execution",
      "args": [
        "$attacker",
        "$host"
      ],
      "value": true,
      "description": "攻撃開始時に、このホスト上で一般ユーザー権限のプロセスを操作できる。前段の効果または明示した開始条件。"
    }
  ],
  "requiredReachability": [],
  "effects": [
    {
      "source": "attackerInitialPrivileges",
      "predicate": "system_execution",
      "args": [
        "$attacker",
        "$host"
      ],
      "value": true,
      "description": "対象Windowsホスト上でLocalSystemとしてプロセスを操作できる。ドメイン権限は含まない。"
    }
  ],
  "observableArtifacts": [
    {
      "id": "service_acl_record",
