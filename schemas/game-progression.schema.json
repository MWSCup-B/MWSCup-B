{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal Game Progression v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "initialState": { "const": "TITLE" },
    "courtRoundCount": { "type": "number" },
    "materialInvestigations": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "object", "properties": {"schemaVersion": {"const": "1.0"}, "evidenceId": {"type": "string", "minLength": 1, "maxLength": 160}, "steps": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "properties": {"prompt": {"type": "string", "minLength": 1, "maxLength": 1000}, "choices": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 1000}, "operation": {"type": "object", "properties": {"kind": {"enum": ["LINES", "MATCH", "COUNT"]}, "firstLine": {"type": "number"}, "lastLine": {"type": "number"}, "needle": {"type": "string", "maxLength": 500}}, "required": ["kind", "firstLine", "lastLine", "needle"], "additionalProperties": false}}, "required": ["description", "operation"], "additionalProperties": false}}, "correctOptionIndex": {"type": "number"}, "explanation": {"type": "string", "minLength": 1, "maxLength": 2000}}, "required": ["prompt", "choices", "correctOptionIndex", "explanation"], "additionalProperties": false}}}, "required": ["schemaVersion", "evidenceId", "steps"], "additionalProperties": false}},
    "investigationMode": { "enum": ["SEQUENTIAL_TARGETS", "OPEN_MATERIALS"] },
    "courtIssues": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "issueId": { "type": "string", "pattern": "^court_issue_[1-9][0-9]*$" },
          "investigationTargetId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "question": { "type": "object", "additionalProperties": true },
          "statementIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" } },
          "judgmentRuleIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" } },
          "requiredEvidenceIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" } }
        },
        "required": ["issueId", "statementIds", "judgmentRuleIds", "requiredEvidenceIds"],
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "items": { "enum": ["TITLE", "INITIAL_COURT", "INVESTIGATION", "RETRIAL_COURT", "OBJECTION", "ACQUITTED", "GUILTY_RETRY", "BLOCKED"] },
      "minItems": 8,
      "maxItems": 8
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "enum": ["TITLE", "INITIAL_COURT", "INVESTIGATION", "RETRIAL_COURT", "OBJECTION", "ACQUITTED", "GUILTY_RETRY", "BLOCKED"] },
          "event": { "enum": ["START", "INITIAL_RULING", "RETURN_TO_COURT_CONDITION_MET", "SELECT_OBJECTION", "SUCCESS", "FAILURE", "RETURN_TO_INVESTIGATION", "LIMIT_REACHED", "NEXT_ISSUE", "INVESTIGATE_AGAIN"] },
          "to": { "enum": ["TITLE", "INITIAL_COURT", "INVESTIGATION", "RETRIAL_COURT", "OBJECTION", "ACQUITTED", "GUILTY_RETRY", "BLOCKED"] }
        },
        "required": ["from", "event", "to"],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 11
    },
    "initialCourt": {
      "type": "object",
      "properties": {
        "incidentOverview": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "prosecutionOpening": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "prosecutionStatements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statementId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
              "speakerCharacterId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
              "spokenContent": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "displayOrder": { "type": "number" }
            },
            "required": ["statementId", "speakerCharacterId", "spokenContent", "displayOrder"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "presentedEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 1, "maxItems": 512 },
        "speakerCharacterIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 1, "maxItems": 64 },
        "publicRuling": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "attributionStatus": { "const": "ALLEGATION_ONLY" },
        "nextState": { "const": "INVESTIGATION" }
      },
      "required": ["prosecutionStatements", "presentedEvidenceIds", "speakerCharacterIds", "publicRuling", "attributionStatus", "nextState"],
      "additionalProperties": false
    },
    "investigation": {
      "type": "object",
      "properties": {
        "availableEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 1, "maxItems": 512 },
        "initialAvailableTargetIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 1, "maxItems": 128 },
        "completedInvestigationActions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 0, "maxItems": 4096 },
        "discoveredEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 0, "maxItems": 512 },
        "collectedEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 0, "maxItems": 512 },
        "requiredForCourtIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 1, "maxItems": 512 },
        "returnToCourtCondition": { "enum": ["AT_LEAST_ONE_EVIDENCE_COLLECTED", "ALL_REQUIRED_EVIDENCE_COLLECTED", "CURRENT_TARGET_EVIDENCE_COLLECTED"] }
      },
      "required": ["availableEvidenceIds", "initialAvailableTargetIds", "completedInvestigationActions", "discoveredEvidenceIds", "collectedEvidenceIds", "requiredForCourtIds", "returnToCourtCondition"],
      "additionalProperties": false
    },
    "retrialCourt": {
      "type": "object",
      "properties": {
        "testimonies": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "minItems": 1, "maxItems": 512 },
        "presentableEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }, "minItems": 1, "maxItems": 512 }
      },
      "required": ["testimonies", "presentableEvidenceIds"],
      "additionalProperties": false
    },
    "objection": {
      "type": "object",
      "properties": {
        "action": { "const": "OBJECTION" },
        "requiredInputs": { "type": "array", "items": { "enum": ["statementId", "evidenceId", "interpretationChoiceId"] }, "minItems": 2, "maxItems": 3 },
        "successState": { "const": "ACQUITTED" },
        "failureState": { "enum": ["GUILTY_RETRY", "INVESTIGATION"] }
      },
      "required": ["action", "requiredInputs", "successState", "failureState"],
      "additionalProperties": false
    },
    "retryState": {
      "type": "object",
      "properties": {
        "previouslyPresentedStatementId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
        "previouslyPresentedEvidenceId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
        "attemptCount": { "type": "number" },
        "publicFailureFeedback": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "nextState": { "const": "INVESTIGATION" }
      },
      "required": ["previouslyPresentedStatementId", "previouslyPresentedEvidenceId", "attemptCount", "publicFailureFeedback", "nextState"],
      "additionalProperties": false
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "maxCourtAttempts": { "type": "number" },
        "onFailure": { "const": "RETURN_TO_INVESTIGATION" },
        "onLimitReached": { "const": "BLOCKED" }
      },
      "required": ["maxCourtAttempts", "onFailure", "onLimitReached"],
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "acquitted": {
          "type": "object",
          "properties": {
            "state": { "const": "ACQUITTED" },
            "publicRuling": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "publicExplanation": { "type": "string", "minLength": 1, "maxLength": 16000 }
          },
          "required": ["state", "publicRuling", "publicExplanation"],
          "additionalProperties": false
        },
        "guiltyRetry": {
          "type": "object",
          "properties": {
            "state": { "const": "GUILTY_RETRY" },
            "publicRuling": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "nextState": { "const": "INVESTIGATION" }
          },
          "required": ["state", "publicRuling", "nextState"],
          "additionalProperties": false
        }
      },
      "required": ["acquitted", "guiltyRetry"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "initialState", "courtRoundCount", "states", "transitions", "initialCourt", "investigation", "retrialCourt", "objection", "retryState", "retryPolicy", "outcomes"],
  "additionalProperties": false
}
