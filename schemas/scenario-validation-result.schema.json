{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario Contract Validation Result v1 (Backend internal)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "status": { "enum": ["VALID", "BLOCKED"] },
    "blocked": { "type": "boolean" },
    "scope": { "const": "SCENARIO_CONTRACT_ONLY" },
    "scenarioId": { "type": ["string", "null"], "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "attackGraphRef": {
      "type": ["object", "null"],
      "properties": {
        "inputDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "graphId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }
      },
      "required": ["inputDigest", "graphId"],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Z][A-Z0-9_]*$" },
          "field": { "type": "string", "minLength": 1, "maxLength": 512 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "suggestion": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "relatedIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "required": ["code", "field", "reason", "suggestion", "relatedIds"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": ["schemaVersion", "status", "blocked", "scope", "scenarioId", "attackGraphRef", "issues"],
  "additionalProperties": false
}
