{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ground": {
            "type": "object",
            "properties": {
              "sourceType": { "const": "ATTACK_GRAPH_ARTIFACT" },
              "attackNodeId": { "type": "string", "minLength": 1 },
              "sourceId": { "type": "string", "minLength": 1 }
            },
            "required": ["sourceType", "attackNodeId", "sourceId"],
            "additionalProperties": false
          },
          "evidenceType": { "type": "string", "minLength": 1 },
          "sourceNodeId": { "type": "string", "minLength": 1 },
          "logSource": { "type": "string", "minLength": 1 },
          "actionId": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["ground", "evidenceType", "sourceNodeId", "logSource", "actionId", "requirementIds"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false
}
