{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Discovery Rule v1 (Backend internal)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ruleId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "evidenceId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "targetId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "actionId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "prerequisites": {
      "type": "object",
      "properties": {
        "requiredEvidenceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "minItems": 0,
          "maxItems": 512
        },
        "requiredCompletedActionIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^[a-z][a-z0-9_-]*$" },
          "minItems": 0,
          "maxItems": 512
        }
      },
      "required": ["requiredEvidenceIds", "requiredCompletedActionIds"],
      "additionalProperties": false
    },
    "discoveryResult": {
      "type": "object",
      "properties": {
        "publicMessage": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "discovered": { "const": true },
        "unlockedTargetIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "minItems": 0,
          "maxItems": 128
        },
        "nextHints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": ["publicMessage", "discovered", "unlockedTargetIds", "nextHints"],
      "additionalProperties": false
    },
    "repeatable": { "type": "boolean" }
  },
  "required": ["schemaVersion", "ruleId", "evidenceId", "targetId", "actionId", "prerequisites", "discoveryResult", "repeatable"],
  "additionalProperties": false
}
