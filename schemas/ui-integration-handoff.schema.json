{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Integration Handoff v1 (Backend internal)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "handoffId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "gameCaseId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "gameCaseFingerprint": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "publicGameCaseFingerprint": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "progressionFingerprint": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "evidenceSetId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "verificationId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "state": { "const": "GAME_CASE_READY" },
    "eligibleForUiIntegration": { "const": true }
  },
  "required": ["schemaVersion", "handoffId", "gameCaseId", "gameCaseFingerprint", "publicGameCaseFingerprint", "progressionFingerprint", "scenarioId", "evidenceSetId", "verificationId", "state", "eligibleForUiIntegration"],
  "additionalProperties": false
}
