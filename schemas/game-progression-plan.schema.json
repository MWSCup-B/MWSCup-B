{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Progression Plan v1 (Backend internal)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "evidenceSetId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "attackGraphRef": {
      "type": "object",
      "properties": {
        "inputDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "graphId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }
      },
      "required": ["inputDigest", "graphId"],
      "additionalProperties": false
    },
    "initialCourtEvidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
      "minItems": 1,
      "maxItems": 512
    },
    "initialCourtStatementIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
      "minItems": 1,
      "maxItems": 512
    },
    "investigationEvidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
      "minItems": 1,
      "maxItems": 512
    },
    "investigationActions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "minItems": 8,
      "maxItems": 64
    },
    "investigationTargets": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "minItems": 1,
      "maxItems": 128
    },
    "evidenceDiscoveryRules": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "minItems": 1,
      "maxItems": 512
    },
    "initialAvailableTargetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
      "minItems": 1,
      "maxItems": 128
    },
    "retrialStatementIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
      "minItems": 1,
      "maxItems": 512
    },
    "returnToCourtCondition": { "enum": ["AT_LEAST_ONE_EVIDENCE_COLLECTED", "ALL_REQUIRED_EVIDENCE_COLLECTED", "CURRENT_TARGET_EVIDENCE_COLLECTED"] },
    "courtRoundCount": { "type": "number" },
    "materialInvestigations": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "object", "properties": {"schemaVersion": {"const": "1.0"}, "evidenceId": {"type": "string", "minLength": 1, "maxLength": 160}, "steps": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "properties": {"prompt": {"type": "string", "minLength": 1, "maxLength": 1000}, "choices": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 1000}, "operation": {"type": "object", "properties": {"kind": {"enum": ["LINES", "MATCH", "COUNT"]}, "firstLine": {"type": "number"}, "lastLine": {"type": "number"}, "needle": {"type": "string", "maxLength": 500}}, "required": ["kind", "firstLine", "lastLine", "needle"], "additionalProperties": false}}, "required": ["description", "operation"], "additionalProperties": false}}, "correctOptionIndex": {"type": "number"}, "explanation": {"type": "string", "minLength": 1, "maxLength": 2000}}, "required": ["prompt", "choices", "correctOptionIndex", "explanation"], "additionalProperties": false}}}, "required": ["schemaVersion", "evidenceId", "steps"], "additionalProperties": false}},
    "investigationMode": { "enum": ["SEQUENTIAL_TARGETS", "OPEN_MATERIALS"] },
    "courtIssueMode": { "const": "DISTINCT_CLAIMS" },
    "courtQuestions": { "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "type": "object", "additionalProperties": true } },
    "objectionRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectionRuleId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "targetStatementId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "acceptedEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
            "minItems": 1,
            "maxItems": 64
          },
          "contradictionRef": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "exonerationRef": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "required": ["objectionRuleId", "targetStatementId", "acceptedEvidenceIds", "contradictionRef", "exonerationRef"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "maxCourtAttempts": { "type": "number" },
        "onFailure": { "const": "RETURN_TO_INVESTIGATION" },
        "onLimitReached": { "const": "BLOCKED" }
      },
      "required": ["maxCourtAttempts", "onFailure", "onLimitReached"],
      "additionalProperties": false
    },
    "publicMessages": {
      "type": "object",
      "properties": {
        "incidentOverview": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "prosecutionOpening": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "initialRuling": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "acquittalRuling": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "acquittalExplanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "failureFeedback": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "required": ["initialRuling", "acquittalRuling", "acquittalExplanation", "failureFeedback"],
      "additionalProperties": false
    },
    "fingerprint": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["schemaVersion", "planId", "scenarioId", "evidenceSetId", "attackGraphRef", "initialCourtEvidenceIds", "initialCourtStatementIds", "investigationEvidenceIds", "investigationActions", "investigationTargets", "evidenceDiscoveryRules", "initialAvailableTargetIds", "retrialStatementIds", "returnToCourtCondition", "courtRoundCount", "objectionRules", "retryPolicy", "publicMessages", "fingerprint"],
  "additionalProperties": false
}
