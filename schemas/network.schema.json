{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "os": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "trustZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "required": [
          "id",
          "type",
          "roles",
          "os",
          "trustZone"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "nodeId",
          "type",
          "platform"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "trustZones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "reachability": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "toService": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "value": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "from",
          "toService",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2048
    }
  },
  "required": [
    "schemaVersion",
    "nodes",
    "services",
    "trustZones",
    "connections",
    "reachability"
  ],
  "additionalProperties": false
}
