{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ground Truth v1 (Backend internal)",
  "type": "object",
  "properties": {
    "caseFacts": {
      "type": "array", "minItems": 0, "maxItems": 48,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "schemaVersion": { "const": "1.0" },
          "factId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "attackNodeId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "witnessCharacterId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "subjectCharacterId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "excludedCharacterId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "observation": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "relatedArtifactIds": { "type": "array", "minItems": 1, "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" } }
        },
        "required": ["schemaVersion", "factId", "attackNodeId", "witnessCharacterId", "subjectCharacterId", "excludedCharacterId", "observation", "relatedArtifactIds"]
      }
    },
    "incidentNarratives": {
      "type": ["array", "null"], "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "schemaVersion": { "const": "1.0" },
          "attackNodeId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "impactEffectId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "attackerCharacterId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "defendantCharacterId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "attackerAction": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "impact": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "allegation": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "prosecutionKnowledge": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "causalRefutation": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "verdictBasis": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "requiredArtifactIds": { "type": "array", "minItems": 2, "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
        },
        "required": ["schemaVersion", "attackNodeId", "impactEffectId", "attackerCharacterId", "defendantCharacterId", "attackerAction", "impact", "allegation", "prosecutionKnowledge", "causalRefutation", "verdictBasis", "requiredArtifactIds"]
      }
    },
    "schemaVersion": { "const": "1.0" },
    "groundTruthId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "attackGraphRef": {
      "type": "object",
      "properties": {
        "inputDigest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "graphId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }
      },
      "required": ["inputDigest", "graphId"],
      "additionalProperties": false
    },
    "technicalFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "sourceType": { "enum": ["ATTACK_NODE", "NODE_EVALUATION", "NODE_EFFECT", "ATTACK_EDGE"] },
          "attackNodeId": { "type": ["string", "null"], "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "required": ["factId", "sourceType", "attackNodeId", "sourceId"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2048
    },
    "characterFactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "characterId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
          "role": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "required": ["characterId", "role"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": ["schemaVersion", "groundTruthId", "scenarioId", "attackGraphRef", "technicalFacts", "characterFactRefs"],
  "additionalProperties": false
}
