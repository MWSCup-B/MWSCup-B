{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Evaluation Result v1 (Backend internal)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "evaluationId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9_-]*$" },
    "status": { "enum": ["ACCEPTED", "NEEDS_REVISION", "BLOCKED"] },
    "accepted": { "type": "boolean" },
    "evaluationInputRef": { "type": "object", "additionalProperties": true },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "enum": ["UPSTREAM_INTEGRITY", "NORMAL_PLAYTHROUGH", "RETRY_PLAYTHROUGH", "LIMIT_PLAYTHROUGH", "INVESTIGATION_REACHABILITY", "INVESTIGATION_DISCLOSURE", "SOLVABILITY", "BRUTE_FORCE_RESISTANCE", "INFORMATION_DISCLOSURE", "USABILITY"] },
          "status": { "enum": ["PASS", "FAIL"] },
          "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 }, "minItems": 1, "maxItems": 128 }
        },
        "required": ["category", "status", "sourceRefs"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Z][A-Z0-9_]*$" },
          "category": { "type": "string", "minLength": 1, "maxLength": 100 },
          "target": { "type": "string", "minLength": 1, "maxLength": 512 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "correctionHint": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 }, "minItems": 1, "maxItems": 128 }
        },
        "required": ["code", "category", "target", "reason", "correctionHint", "sourceRefs"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "minItems": 1, "maxItems": 32 }
  },
  "required": ["schemaVersion", "evaluationId", "status", "accepted", "evaluationInputRef", "checks", "issues", "limitations"],
  "additionalProperties": false
}
