{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Interpretation Question v1 (Backend internal)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "statementId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
    "choices": { "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "correctOptionIndex": { "enum": [0, 1, 2, 3] },
    "supportingQuotes": { "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "type": "object", "properties": {
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9_-]*$" },
        "quote": { "type": "string", "minLength": 6, "maxLength": 1000 }
      }, "required": ["evidenceId", "quote"], "additionalProperties": false } },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "required": ["schemaVersion", "statementId", "prompt", "choices", "correctOptionIndex", "supportingQuotes", "explanation"],
  "additionalProperties": false
}
